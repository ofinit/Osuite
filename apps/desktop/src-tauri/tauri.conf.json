{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSuite",
  "version": "0.1.0",
  "identifier": "com.ofinit.osuite",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OSuite",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OfinIT",
    "category": "Business",
    "shortDescription": "Business management for growing companies",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/osuite-server"],
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    }
  }
}
