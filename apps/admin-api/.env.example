# Admin / licensing API (set these in Coolify)
DATABASE_URL=postgres://osuite:CHANGE_ME@postgres:5432/osuite_admin
# Ed25519 private key (PEM). Newlines may be written as \n.
LICENSE_PRIVATE_KEY=
# First owner account, created on first start when no staff exist (change the password after signing in).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
RAZORPAY_WEBHOOK_SECRET=
PORT=47900
