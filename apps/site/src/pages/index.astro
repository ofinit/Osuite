---
import { getImage, Image } from 'astro:assets';
import LiveInvoice from '../components/LiveInvoice.astro';
import Plans from '../components/Plans.astro';
import Page from '../layouts/Page.astro';
import { SAMPLE } from '../lib/sample';
import { siteData } from '../lib/site';
import { SCREENS } from '../lib/features';
import entryPoster from '../assets/screens/invoice-entry.png';
import printCredit from '../assets/screens/print-credit-note.png';
import printStatement from '../assets/screens/print-statement.png';

const poster = await getImage({ src: entryPoster, width: 1800, format: 'webp' });
const data = await siteData();
const b = data.business;

const outputs = [
  { id: 'invoice', name: 'Tax invoice', note: 'HSN summary, amount in words, IRN and signed QR, bank details and a UPI QR for the exact amount.', img: SCREENS.printInvoice, alt: 'A posted GST tax invoice with its e-invoice IRN, signed QR code, HSN tax table and UPI payment QR' },
  { id: 'quotation', name: 'Quotation', note: 'Valid until a date you choose; one click turns it into an invoice.', img: SCREENS.printQuotation, alt: 'A quotation with validity date, items, GST and amount in words' },
  { id: 'proforma', name: 'Proforma invoice', note: 'The same quotation with your bank details, for customers who pay in advance.', img: SCREENS.printProforma, alt: 'A quotation printed as a proforma invoice with bank details and a UPI QR' },
  { id: 'credit', name: 'Credit note', note: 'Against the original invoice; returned goods come back into stock.', img: printCredit, alt: 'A credit note against an invoice for returned goods' },
  { id: 'statement', name: 'Statement of account', note: 'Opening balance, every bill and payment, and what is due, ready to send.', img: printStatement, alt: "A customer's statement of account with a running balance" },
];

const bento = [
  { slug: 'invoicing', title: 'Invoicing and quotations', text: 'Type the customer and the items; GST, round off and the amount in words follow as you type.', video: '/media/invoice-entry.webm', img: SCREENS.invoiceEntry, focus: '30% 0', size: 'big' },
  { slug: 'gst-returns', title: 'GSTR-1 and GSTR-3B', text: 'In the portal’s own tables, from what you posted.', img: SCREENS.gstr1, focus: '25% 0', size: 'wide' },
  { slug: 'e-invoicing', title: 'E-invoices and e-way bills', text: 'Checked before sending; IRN and signed QR printed.', img: SCREENS.invoiceEinvoice, focus: '25% 0', size: 'wide' },
  { slug: 'banking', title: 'Bank reconciliation', text: 'Import the statement; it matches itself.', img: SCREENS.bank, focus: '25% 0', size: 'third' },
  { slug: 'inventory', title: 'Stock you can trust', text: 'By warehouse, at weighted average cost.', img: SCREENS.stock, focus: '25% 0', size: 'third' },
  { slug: 'accounting', title: 'Ledger and day book', text: 'Double entry kept for you, Tally-style.', img: SCREENS.dayBook, focus: '25% 0', size: 'third' },
];

const steps = [
  { title: 'Install it', text: 'One Windows installer. It brings its own database; nothing else to set up.' },
  { title: 'Add your company', text: 'GSTIN, state, bank and UPI details. Invoice numbers start at 0001.' },
  { title: 'Post an invoice', text: 'Place of supply, rates and tax fill themselves in.' },
  { title: 'File by the 11th', text: 'GSTR-1 comes out the way the return asks for it.' },
];

const rules = [
  { fig: '24', unit: 'hours', text: 'to cancel an e-invoice; after that OSuite points you to a credit note' },
  { fig: '200', unit: 'km', text: 'for each day an e-way bill stays valid, counted for you' },
  { fig: '1', unit: 'April', text: 'when invoice numbers restart for the new financial year' },
  { fig: '0', unit: 'internet', text: 'needed for daily work; a licence check every 14 days' },
];

const faqs: [string, string][] = [
  ['Does it work without the internet?', 'Yes. Everything runs on your PC. OSuite goes online for a moment every 14 days to renew its licence; if it cannot, you get 7 more days before it turns read-only, and your data is never locked away.'],
  ['Where is my data kept?', 'In a database on your own computer, not on our servers. Backups run every day and can be copied to a USB disk or a OneDrive or Google Drive folder.'],
  ['Can I move from Tally?', 'Not automatically yet; a Tally import is being built. Today you enter opening balances and open invoices once, and we help you do it.'],
  ['Does it file my GST returns?', 'It prepares them. GSTR-1 and GSTR-3B come out in the portal’s tables, ready for the offline tool or your accountant. Filing stays on the GST portal.'],
  ['What about e-invoicing?', 'OSuite builds and checks the e-invoice and prints the IRN and signed QR. Live registration goes through a GST Suvidha Provider, which is being connected now.'],
  ['How many people can use it?', 'Each plan includes a number of users. Everyone has their own login, and every change is kept in an edit history that cannot be quietly rewritten.'],
  ['What if I stop paying?', 'After the paid period and 7 days of grace, OSuite turns read-only. You can still open every record, print and take backups.'],
  ['Can I get my money back?', `Within ${b.refundDays || 14} days of buying, if OSuite is not for you.`],
];
---

<Page
  title={`${b.brandName}: GST accounting software that runs on your PC`}
  description="GST invoicing, e-invoicing, stock, banking and returns for Indian businesses. Desktop software that works offline and keeps your data on your own computer."
>
  <script type="application/json" id="live-invoice-sample" set:html={JSON.stringify(SAMPLE)} />

  <!-- Hero: the claim, then the product itself, large. -->
  <section class="hero">
    <div class="container hero-text">
      <h1 class="display lines">
        <span class="line"><span data-line>GST accounting</span></span>
        <span class="line"><span data-line style="--i: 1">on your own PC</span></span>
      </h1>
      <div class="hero-side">
        <p class="lead" data-rise style="--i: 3">
          Invoices, e-invoices, stock, banking and GST returns for Indian businesses. It works offline, and your books stay with you.
        </p>
        <div class="hero-actions" data-rise style="--i: 4">
          <a class="button" href="/download">
            Start the 14-day trial
            <span class="btn-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span>
          </a>
          <a class="button quiet" href="/pricing">See prices</a>
        </div>
      </div>
    </div>
    <div class="hero-band">
      <div class="container stage-hero">
        <div class="frame hero-main" data-rise style="--i: 5">
          <video src="/media/invoice-entry.webm" poster={poster.src} autoplay muted loop playsinline preload="metadata" aria-label="An invoice being entered in OSuite: customer, items, GST worked out, posted"></video>
        </div>
        <div class="frame hero-sheet" data-rise style="--i: 7">
          <Image src={SCREENS.printInvoice} alt="The printed tax invoice with HSN summary, IRN and signed QR" widths={[700, 1100]} sizes="(max-width: 48em) 60vw, 30vw" loading="eager" />
        </div>
      </div>
      <ul class="container proof" aria-label="In every plan">
        <li>Works offline</li>
        <li>GSTR-1 and GSTR-3B</li>
        <li>E-invoices and e-way bills</li>
        <li>Daily backups</li>
        <li>Data on your PC</li>
      </ul>
    </div>
  </section>

  <!-- The papers it makes. -->
  <section class="docs section" aria-labelledby="docs-title">
    <div class="container docs-grid">
      <div class="docs-side">
        <h2 id="docs-title" class="head" data-reveal>Papers your customers trust</h2>
        <div class="docs-list" role="tablist" aria-label="Documents">
          {
            outputs.map((o, i) => (
              <button class="out-name" role="tab" id={`tab-${o.id}`} aria-controls={`sheet-${o.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
                {o.name}
              </button>
            ))
          }
        </div>
        {outputs.map((o, i) => (
          <p class="out-note" data-note-for={o.id} hidden={i !== 0}>
            {o.note}
          </p>
        ))}
      </div>
      <div class="docs-stage">
        {
          outputs.map((o, i) => (
            <div class="frame out-sheet" role="tabpanel" id={`sheet-${o.id}`} aria-labelledby={`tab-${o.id}`} hidden={i !== 0}>
              <Image src={o.img} alt={o.alt} widths={[800, 1300]} sizes="(max-width: 48em) 92vw, 40vw" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Live: the visitor sets the invoice; OSuite's own GST code does the sums. -->
  <section class="live" aria-labelledby="live-title">
    <div class="container live-card">
      <div class="live-controls">
        <h2 id="live-title" class="head" data-reveal>Try the tax yourself</h2>
        <p class="muted live-intro" data-reveal>This invoice is worked out by the same GST code OSuite uses. Change anything.</p>
        <fieldset class="ctl" data-reveal>
          <legend>Customer is in</legend>
          <div class="seg">
            {
              Object.entries(SAMPLE.buyers).map(([code, buyer]) => (
                <label>
                  <input type="radio" name="buyer" value={code} data-live="buyer" checked={code === SAMPLE.start.buyer} />
                  <span>{buyer.state}</span>
                </label>
              ))
            }
          </div>
          <p class="small muted">Same state as you: CGST and SGST. Another state: IGST.</p>
        </fieldset>
        <fieldset class="ctl" data-reveal>
          <legend>GST rate</legend>
          <div class="seg">
            {
              ['5', '12', '18', '28'].map((rate) => (
                <label>
                  <input type="radio" name="rate" value={rate} data-live="gstRate" checked={rate === SAMPLE.start.gstRate} />
                  <span>{rate}%</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="ctl pair" data-reveal>
          <label>
            <span class="lbl">Quantity</span>
            <input class="field" type="number" min="0" max="100000000" inputmode="numeric" value={SAMPLE.start.qty} data-live="qty" />
          </label>
          <label>
            <span class="lbl">Rate, ₹</span>
            <input class="field" type="number" min="0" step="0.01" inputmode="decimal" value={SAMPLE.start.rate} data-live="rate" />
          </label>
          <label class="slider">
            <span class="lbl">Discount <output data-echo="discount">0</output>%</span>
            <input type="range" min="0" max="25" step="0.5" value="0" data-live="discount" />
          </label>
        </div>
      </div>
      <div class="live-sheet on-navy">
        <div class="frame"><div class="frame-inner"><LiveInvoice /></div></div>
      </div>
    </div>
  </section>

  <!-- Everything else, as real screens. -->
  <section class="more section" aria-labelledby="more-title">
    <div class="container">
      <div class="more-top">
        <h2 id="more-title" class="head" data-reveal>One book for the whole business</h2>
        <a class="link-plain more-all" href="/features">See everything OSuite does</a>
      </div>
      <div class="bento">
        {
          bento.map((c, i) => (
            <a class={`cell ${c.size}`} href={`/features/${c.slug}`} data-reveal style={`--i: ${i % 3}`}>
              <span class="cell-text">
                <h3 class="cell-title">{c.title}</h3>
                <p class="cell-sub">{c.text}</p>
              </span>
              <span class="cell-shot">
                {c.video ? (
                  <video src={c.video} poster={poster.src} autoplay muted loop playsinline preload="none" aria-hidden="true" style={`object-position: ${c.focus}`} />
                ) : (
                  <Image src={c.img} alt="" widths={[700, 1200]} sizes="(max-width: 48em) 92vw, 40vw" style={`object-position: ${c.focus}`} />
                )}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Your data. -->
  <section class="data on-navy" aria-labelledby="data-title">
    <div class="container data-grid">
      <div class="data-text">
        <h2 id="data-title" class="head" data-reveal>Your books stay with you</h2>
        <ul class="data-points">
          <li data-reveal style="--i: 1"><strong>On your PC.</strong> A database of its own, not on our servers. Daily work needs no internet.</li>
          <li data-reveal style="--i: 2"><strong>Backed up every day.</strong> With a copy on a USB disk or in OneDrive, and a safety copy before any restore.</li>
          <li data-reveal style="--i: 3"><strong>Honest records.</strong> Posted documents are locked and every change is hash-chained, so nothing is quietly rewritten.</li>
        </ul>
        <a class="button on-dark" href="/security">How we keep it safe</a>
      </div>
      <div class="frame data-shot" data-reveal style="--i: 2">
        <Image src={SCREENS.backups} alt="The backups screen: a daily schedule, a second folder for copies, and the list of backups" widths={[900, 1500]} sizes="(max-width: 48em) 92vw, 50vw" />
      </div>
    </div>
  </section>

  <!-- How it works, and the rules it keeps. -->
  <section class="steps section" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="head" data-reveal>Invoicing by tonight</h2>
      <ol class="step-row">
        {
          steps.map((s, i) => (
            <li data-reveal style={`--i: ${i}`}>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <dl class="rules">
        {
          rules.map((r, i) => (
            <div data-reveal style={`--i: ${i}`}>
              <dt class="nums"><span class="fig">{r.fig}</span> <span class="unit">{r.unit}</span></dt>
              <dd>{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="pricing section" aria-labelledby="plans-title" id="pricing">
    <div class="container">
      <Plans data={data} />
    </div>
  </section>

  <section class="faq section" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <h2 id="faq-title" class="head" data-reveal>Questions people ask</h2>
      <dl class="faq-list">
        {
          faqs.map(([q, a], i) => (
            <div data-reveal style={`--i: ${i % 2}`}>
              <dt>{q}</dt>
              <dd>{a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <script>
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('video[autoplay]').forEach((v) => (v as HTMLVideoElement).pause());
    import '../scripts/live-invoice.ts';
    import '../scripts/outputs.ts';
  </script>
</Page>

<style>
  /* ---------- hero ---------- */
  .hero { padding-top: clamp(3rem, 7vw, 8rem); }
  /* The headline takes the full width on two lines; the pitch and actions sit under its end. */
  .hero-text { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(1.5rem, 3vw, 3rem) var(--gutter); align-items: end; }
  .hero-text h1 { grid-column: 1 / -1; white-space: nowrap; }
  .hero-side { grid-column: 2; }
  .hero-text h1 { font-size: clamp(2.5rem, 0.5rem + 7.2vw, 10rem); }
  .hero-side .lead { max-width: 34ch; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: clamp(1.5rem, 2.5vw, 2.25rem); }
  /* The product sits half on white, half on the sage band below. */
  .hero-band { position: relative; isolation: isolate; margin-top: clamp(3rem, 6vw, 6rem); padding-bottom: clamp(3rem, 6vw, 6rem); }
  .hero-band::before { content: ''; position: absolute; inset: 30% 0 0 0; z-index: -1; background: var(--surface); }
  .stage-hero { position: relative; padding-bottom: clamp(2rem, 5vw, 5rem); }
  .hero-main { width: 78%; }
  .hero-main video { aspect-ratio: 16 / 10; object-fit: cover; object-position: 20% 0; }
  .hero-sheet { position: absolute; right: 0; top: 14%; width: 31%; }
  .hero-sheet img { aspect-ratio: 3 / 4; object-fit: cover; object-position: 0 0; }
  .proof { display: flex; flex-wrap: wrap; gap: 0.75rem 2.25rem; font-weight: 500; color: var(--muted); font-size: var(--step-small); }
  .proof li { display: flex; align-items: center; gap: 0.6rem; }
  .proof li::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--accent); }

  /* ---------- documents ---------- */
  .docs-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--gutter) clamp(2rem, 5vw, 6rem); align-items: start; }
  .docs-side { position: sticky; top: 7rem; }
  .docs-list { display: grid; gap: 0.25rem; margin-top: clamp(1.5rem, 3vw, 2.75rem); }
  .out-name { text-align: left; padding: 0.7rem 1.25rem; border-radius: 999px; font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.02em; color: #6b7482; transition: background-color var(--t-hover) var(--ease-soft), color var(--t-hover) ease; }
  .out-name[aria-selected='true'] { background: var(--surface); color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .out-name:hover { color: var(--ink); } }
  .out-note { margin-top: 1.5rem; padding-left: 1.25rem; max-width: 40ch; }
  .docs-stage { background: var(--surface); border-radius: var(--r-card); padding: clamp(1.5rem, 4vw, 4.5rem); display: grid; place-items: center; }
  .out-sheet { width: min(100%, 46rem); }
  .js .out-sheet:not([hidden]) { animation: sheet-in 260ms var(--ease-out) both; }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ---------- live ---------- */
  .live { padding-block: calc(var(--section) / 2); }
  .live-card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); border-radius: var(--r-card); overflow: hidden; background: var(--surface); }
  .live-controls { padding: clamp(2rem, 4.5vw, 5rem); display: grid; gap: clamp(1.25rem, 2vw, 2rem); align-content: start; }
  .live-intro { margin-top: -0.5rem; }
  .ctl { border: 0; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .ctl legend, .lbl { font-weight: 600; font-size: var(--step-small); padding: 0; }
  .ctl legend { margin-bottom: 0.75rem; }
  .lbl { display: block; margin-bottom: 0.5rem; }
  .seg { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .seg label { position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; cursor: pointer; z-index: 1; margin: 0; }
  .seg span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.1rem; background: var(--bg); border-radius: 999px; font-weight: 500; font-size: var(--step-small); transition: background-color var(--t-hover) var(--ease-soft), color var(--t-hover) ease, transform var(--t-press) var(--ease-out); }
  .seg input:checked + span { background: var(--accent); color: var(--accent-ink); }
  .seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 3px; }
  .seg label:active span { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .seg input:not(:checked) + span:hover { background: var(--surface-2); } }
  .pair { grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pair .slider { grid-column: 1 / -1; }
  .field { width: 100%; min-height: 3rem; padding: 0.7rem 1rem; background: var(--bg); border: 0; border-radius: 12px; font-size: var(--step-body); font-variant-numeric: tabular-nums; }
  .slider input { width: 100%; accent-color: var(--accent); height: 2.75rem; }
  .live-sheet { background: var(--accent); display: grid; place-items: center; padding: clamp(2rem, 4.5vw, 5rem); }
  .live-sheet .frame { width: min(100%, 38rem); }
  .live-sheet :global(.inv) { width: 100%; font-size: clamp(0.8125rem, 0.62rem + 0.36vw, 1.0625rem); padding: clamp(1.25rem, 2vw, 2.25rem); }

  /* ---------- bento ---------- */
  .more-top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 3rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .more-top h2 { max-width: 16ch; }
  .more-all { font-weight: 500; }
  .bento { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(clamp(15rem, 22vw, 28rem), auto); gap: var(--gutter); }
  .cell { display: flex; flex-direction: column; overflow: hidden; border-radius: var(--r-card); background: var(--surface); text-decoration: none; transition: background-color var(--t-hover) var(--ease-soft); }
  .cell.big { grid-column: span 7; grid-row: span 2; }
  .cell.wide { grid-column: span 5; }
  .cell.third { grid-column: span 4; }
  .cell-text { display: grid; gap: 0.35rem; padding: clamp(1.25rem, 2.2vw, 2.25rem) clamp(1.25rem, 2.2vw, 2.25rem) 0; }
  .cell-title { font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.02em; line-height: 1.15; }
  .cell-sub { color: var(--muted); max-width: 40ch; }
  .cell-shot { display: block; flex: 1; position: relative; margin: clamp(1rem, 2vw, 2rem) 0 0 clamp(1.25rem, 2.2vw, 2.25rem); border-radius: 14px 0 0 0; overflow: hidden; background: #fff; min-height: 10rem; }
  /* Each screen is cropped past the app's sidebar and enlarged so its content reads. */
  .cell-shot img, .cell-shot video { position: absolute; top: 0; left: calc(var(--zoom, 1.55) * -16%); width: calc(var(--zoom, 1.55) * 100%); height: auto; max-width: none; display: block; transition: transform 900ms var(--ease-soft); transform-origin: 30% 0; }
  .cell.big .cell-shot video { --zoom: 1.2; }
  @media (hover: hover) and (pointer: fine) {
    .cell:hover { background: var(--surface-2); }
    .cell:hover .cell-shot img, .cell:hover .cell-shot video { transform: scale(1.03); }
  }

  /* ---------- data ---------- */
  .data { background: var(--navy-deep); color: #e8ecf6; padding-block: var(--section); }
  .data-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 6rem); align-items: center; }
  .data h2 { color: #fff; max-width: 12ch; }
  .data-points { display: grid; gap: 1.25rem; margin: clamp(1.75rem, 3vw, 2.5rem) 0 clamp(2rem, 3vw, 2.75rem); }
  .data-points li { max-width: 46ch; color: #c4cde3; }
  .data-points strong { color: #fff; font-weight: 600; }

  /* ---------- steps and rules ---------- */
  .step-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin-top: clamp(2rem, 4vw, 3.5rem); }
  .step-row li { display: grid; gap: 0.5rem; align-content: start; padding-top: 1.25rem; position: relative; }
  .step-row li::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; border-radius: 3px; background: var(--surface-2); }
  .step-row li:first-child::before { background: var(--accent); }
  .step-title { font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.02em; }
  .step-text { color: var(--muted); max-width: 34ch; }
  .rules { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin-top: clamp(3rem, 6vw, 6rem); padding: clamp(1.75rem, 3vw, 3rem); border-radius: var(--r-card); background: var(--surface); }
  .rules dt { display: flex; align-items: baseline; gap: 0.4rem; }
  .fig { font-weight: 600; font-size: var(--step-head); letter-spacing: -0.05em; line-height: 1; }
  .unit { font-weight: 500; color: var(--muted); }
