---
// Text pages (legal, about, your data): the same hero as every other page,
// then the reading text beside a list of its sections that stays in view.
import PageHero from '../components/PageHero.astro';
import type { Shot } from '../lib/features';
import Page from './Page.astro';

interface Props {
  title: string;
  description: string;
  /** Display title on two short lines. */
  lines: [string, string];
  standfirst?: string;
  /** e.g. "Last updated 15 October 2026" */
  meta?: string;
  shot?: Shot;
}
const { title, description, lines, standfirst, meta, shot } = Astro.props;
---

<Page title={title} description={description}>
  <PageHero lines={lines} lead={standfirst} meta={meta} shot={shot} />
  <div class="container reading">
    <nav class="toc" aria-label="On this page" data-toc hidden>
      <p class="toc-title small">On this page</p>
      <ol></ol>
    </nav>
    <article class="prose">
      <slot />
    </article>
  </div>
  <script is:inline>
    // Each block of the text rises in as it is reached (content stays visible without script),
    // and the sections are listed beside it when there are enough of them.
    const heads = document.querySelectorAll('.prose > h2');
    document.querySelectorAll('.prose > *').forEach((el, i) => {
      el.setAttribute('data-reveal', '');
      el.style.setProperty('--i', String(i % 3));
    });
    const toc = document.querySelector('[data-toc]');
    if (toc && heads.length > 2) {
      const ol = toc.querySelector('ol');
      heads.forEach((h, i) => {
        h.id ||= 's-' + (i + 1);
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent;
        li.append(a);
        ol.append(li);
      });
      toc.hidden = false;
    }
  </script>
  <slot name="after" />
</Page>

<style>
  .reading { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--gutter); padding-bottom: var(--section); }
  .prose { grid-column: 2; max-width: 68ch; }
  .toc { grid-column: 1; grid-row: 1; align-self: start; position: sticky; top: 6.5rem; padding: clamp(1.25rem, 2vw, 2rem); border-radius: var(--r-card); background: var(--surface); max-width: 24rem; }
  .toc-title { color: var(--muted); margin-bottom: 0.75rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  /* The links are written by the script, so they carry no scoped attribute. */
  .toc :global(a) { text-decoration: none; font-weight: 500; line-height: 1.3; }
  @media (hover: hover) and (pointer: fine) {
    .toc :global(a:hover) { color: var(--accent); }
  }
  .prose :global(h2) { font-size: var(--step-lead); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; margin: 3rem 0 0.75rem; max-width: 30ch; scroll-margin-top: 6.5rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { max-width: 66ch; }
  .prose :global(p + p) { margin-top: 1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; margin: 0.75rem 0; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li::marker) { color: var(--muted); }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 0.07em; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(dl) { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1.5rem; margin: 1rem 0; }
  .prose :global(dt) { color: var(--muted); }
  @media (max-width: 63.99em) {
    .reading { grid-template-columns: 1fr; }
    .prose { grid-column: 1; }
    .toc { position: static; grid-row: auto; max-width: none; margin-bottom: 1rem; }
  }
  @media (max-width: 47.99em) {
    .prose :global(dl) { grid-template-columns: 1fr; }
  }
</style>
