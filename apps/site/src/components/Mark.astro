---
// The OSuite mark: an "O" ruled with a ledger's crimson margin line (same as the app).
interface Props {
  size?: number;
  paper?: string;
  ink?: string;
}
const { size = 26, paper = '#ffffff', ink = '#0b0d12' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 26 26" aria-hidden="true" class="mark">
  <rect x="1" y="1" width="24" height="24" rx="5" fill={paper}></rect>
  <line x1="8" y1="2" x2="8" y2="24" stroke="#a3141b" stroke-width="1.5"></line>
  <circle cx="15.5" cy="13" r="5" fill="none" stroke={ink} stroke-width="2.2"></circle>
</svg>
